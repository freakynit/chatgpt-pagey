# Public HTTPS origin of this MCP server, with no trailing slash.
# Required in production. Example: https://pagey-mcp.example.com
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Address the HTTP server binds to. Use 0.0.0.0 inside a container.
HOST=127.0.0.1
PORT=8787

# Where the SQLite database and the generated encryption secret live.
DATA_DIR=./data

# Optional. A long random secret used to encrypt Pagey API tokens at rest and
# to sign the short-lived OAuth form cookie. If omitted, one is generated in
# DATA_DIR/secret on first start. Set this explicitly when DATA_DIR is ephemeral.
# PAGEY_MCP_SECRET=

# Pagey API. Leave the default unless you run Pagey yourself.
# PAGEY_API_URL=https://pagey.site/api
# PAGEY_SITE_DOMAIN=pagey.site
# PAGEY_SITE_PROTOCOL=https

# Set to 1 when the server is behind a trusted reverse proxy so OAuth rate
# limiting sees the real client address.
TRUST_PROXY=0

# Maximum site content accepted per publish (decoded bytes).
# MAX_UPLOAD_BYTES=52428800

# Maximum JSON request size accepted by /mcp. Base64 assets inflate by ~33%.
# MCP_BODY_LIMIT=67108864
