{
  "name": "chatgpt-pagey",
  "version": "1.0.1",
  "description": "Publish and manage free Pagey static sites from ChatGPT.",
  "type": "module",
  "license": "MIT",
  "author": "Nitin Bansal",
  "repository": {
    "type": "git",
    "url": "https://github.com/freakynit/chatgpt-pagey.git"
  },
  "homepage": "https://github.com/freakynit/chatgpt-pagey#readme",
  "bugs": "https://github.com/freakynit/chatgpt-pagey/issues",
  "keywords": [
    "chatgpt",
    "chatgpt-plugin",
    "mcp",
    "model-context-protocol",
    "pagey",
    "static-site",
    "hosting",
    "deploy"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "stdio": "node dist/stdio.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e": "tsx scripts/e2e.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:remote": "tsx scripts/remote-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
