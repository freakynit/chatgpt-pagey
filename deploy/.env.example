# Copy to the repository root as `.env` before running docker compose.
# A DNS A/AAAA record for this hostname must already point at the server.
MCP_DOMAIN=mcp.example.com

# Optional. Compose passes this file to the container, so only put server
# settings here. PUBLIC_BASE_URL and HOST are set by docker-compose.yml.
# PAGEY_MCP_SECRET=replace-with-at-least-32-random-characters
# LOG_LEVEL=info
# PAGEY_SITE_DOMAIN=pagey.site
